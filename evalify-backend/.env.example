# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection String (typically Supabase Connection Pooler or Direct Connection string)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:6543/postgres?sslmode=require
DATABASE_URL=your-supabase-postgresql-connection-string

# Supabase Project Credentials
# Found under: Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Code Execution Token (Optional - register at glot.io to run code inside CodingIDE)
GLOT_TOKEN=your-glot-io-token
